# CSIP environment configuration example.
# Copy to `.env` and adjust. NEVER commit real `.env` files, credentials,
# cookies, session tokens, or service-role keys to source control.

# --- Core -------------------------------------------------------------------
# Safe local mode: fixtures only, no live acquisition possible.
CSIP_LOCAL_MODE=true
CSIP_APP_ENV=local
CSIP_LOG_LEVEL=INFO

# --- Database (self-hosted Supabase / PostgreSQL) ----------------------------
# Required when CSIP_LOCAL_MODE=false.
CSIP_DATABASE_URL=postgresql://csip_app:CHANGE_ME@localhost:5432/csip
# Logical database role used by the ingestion writer (least privilege).
CSIP_DB_INGEST_ROLE=csip_ingest

# --- Agno AgentOS -----------------------------------------------------------
CSIP_AGNO_DB_URL=postgresql://csip_agno:CHANGE_ME@localhost:5432/csip
CSIP_AGNO_QUEUE_MAX_CONCURRENCY=2
CSIP_AGNO_QUEUE_MAX_DEPTH=100
# Keep at 1 until external side effects are proven idempotent (see blueprint 8.2).
CSIP_AGNO_QUEUE_MAX_ATTEMPTS=1

# --- Ollama -----------------------------------------------------------------
CSIP_OLLAMA_BASE_URL=http://localhost:11434
CSIP_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Browser / CDP (Phase 4+, must stay localhost or private network) --------
CSIP_CDP_ENABLED=false
# Validated at startup: must be loopback or a private-network address.
CSIP_CDP_BIND_HOST=127.0.0.1
CSIP_CDP_PORT=9222
CSIP_BROWSER_PROFILE_DIR=artifacts/local-only/browser-profile

# --- Acquisition limits -----------------------------------------------------
CSIP_MAX_PAGES_PER_RUN=10
CSIP_MAX_CONCURRENCY=1
CSIP_HTTP_TIMEOUT_SECONDS=30
